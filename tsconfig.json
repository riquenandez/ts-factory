{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "bun-yaml.d.ts",
    ".claude/skills/sssf/factory/adws/**/*.ts",
    ".claude/skills/sssf/scripts/**/*.ts",
    "tools/parity/**/*.ts"
  ],
  "exclude": [
    ".claude/skills/sssf/apps/visualizer/**",
    ".claude/skills/sssf/factory/harness_engineering/**",
    "**/node_modules/**",
    "**/fixtures/repo_*/**"
  ]
}
