#!/usr/bin/env bun
const DOC = `ADW Plan Build — generated by makeAdw: planner -> builder.

Phases: engineer(request) -> planner -> builder
`;

import * as agents from "./adw_modules/agents.ts";
import * as gates from "./adw_modules/gates.ts";
import * as session from "./adw_modules/session.ts";
import { adw } from "./adw_modules/cli.ts";
import { BuildOutput, PlanOutput } from "./adw_modules/dataTypes.ts";

const REQUIRED_AGENTS = ["planner", "builder"];

await adw(DOC, async ({ cfg, prompt, adwId }) => {
  agents.validate(cfg, REQUIRED_AGENTS);
  const run = session.ensure(cfg, adwId);
  await run.request(prompt);

  // TODO: replace this description — say what THIS phase does and why.
  const plan = await run.phase({
    name: "plan",
    kind: "agent",
    owner: "planner",
    description: "Run planner over the request and hand its envelope on",
  }, async (ph) => {
    return await ph.call({
      outputType: PlanOutput,
      prompt,
      gates: [gates.artifactsExist, gates.filesNonEmpty],
    }) as PlanOutput;
  });

  // TODO: replace this description — say what THIS phase does and why.
  await run.phase({
    name: "build",
    kind: "agent",
    owner: "builder",
    description: "Run builder over the request and hand its envelope on",
  }, async (ph) => {
    return await ph.call({
      outputType: BuildOutput,
      prompt,
      previous: plan,
      gates: [gates.diffMatchesClaims],
    }) as BuildOutput;
  });

  return run.finish();
});
