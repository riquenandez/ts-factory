INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_01_request','','log','request','{"input":"summarize"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_01_request','','log','request','{"message":"  · input: summarize","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_01_request','','phase_end','request','{"status":"success"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_01_request','','log','request','{"message":"  ✓ request <DUR>s","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','phase_start','prompt','{"kind":"agent","owner":"scout","description":"Send the request straight to scout and parse its envelope"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','log','prompt','{"message":"▶ 02 prompt  agent · scout  Send the request straight to scout and parse its envelope","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','agent_start','scout','{"model":"google/gemini-3.6-flash","thinking":"medium","color":"","session_id":"sssf-abcd1234-scout-<HEX4>","coding_agent":"pi","purpose":"Find and report where things live; change nothing.","tools":["read","grep","find","ls","bash","write"],"harness_engineering":[]}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','log','prompt','{"message":"  ▸ scout google/gemini-3.6-flash  session sssf-abcd1234-scout-<HEX4>","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','log','paths_touched','{"agent":"scout","paths":["adws/adw_data/sessions/abcd1234/scout/raw_output.jsonl"]}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','log','prompt','{"message":"  ✓ GenericOutput repo has a README","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','handoff','scout','{"artifacts":[],"summary":"repo has a README"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','agent_end','scout','{"cost":0.001,"usage":{"input_tokens":10,"output_tokens":5,"cache_read_tokens":0,"cache_write_tokens":0,"reasoning_tokens":0,"total_tokens":15,"input_cost":0,"output_cost":0,"cache_read_cost":0,"cache_write_cost":0,"total_cost":0.001},"context_tokens":15,"context_window":272000}',15,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','log','prompt','{"message":"  └ scout used 15 tokens · $<COST>","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','phase_end','prompt','{"status":"success"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_prompt','','log','prompt','{"message":"  ✓ prompt <DUR>s","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','','','log','console','{"message":"session abcd1234 success · 2/2 phases · 15 tokens · $<COST>","level":"info"}',NULL,'<TS>',NULL);
CREATE TABLE envelopes (
  envelope_id   TEXT PRIMARY KEY,
  adw_id        TEXT REFERENCES sessions,
  phase_id      TEXT REFERENCES phases,
  agent         TEXT,
  output_type   TEXT,
  payload_json  TEXT,
  valid         INTEGER,
  attempt       INTEGER,
  created_at    TEXT
);
INSERT INTO envelopes VALUES('env_<ID>','abcd1234','abcd1234_02_prompt','scout','GenericOutput',unistr('{\\u000a  "status": "success",\\u000a  "summary": "repo has a README",\\u000a  "artifacts": [],\\u000a  "notes_for_next_agent": ""\\u000a}'),1,1,'<TS>');
CREATE TABLE gate_results (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  adw_id        TEXT REFERENCES sessions,
  phase_id      TEXT REFERENCES phases,
  attempt       INTEGER,
  gate          TEXT,
  passed        INTEGER,
  violations_json TEXT,
  checks_json   TEXT,               -- [{item, ok, note}] — WHAT the gate verified
  created_at    TEXT
);
CREATE TABLE processes (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  adw_id        TEXT REFERENCES sessions,
  kind          TEXT,                -- 'adw' (the workflow process) | 'agent' (a coding-agent child)
  name          TEXT,                -- '' for the adw, the agent name for a child
  pid           INTEGER,
  command       TEXT,                -- what the pid was, so a recycled pid is not killed by mistake
  started_at    TEXT, ended_at TEXT  -- ended_at NULL = believed alive
);
INSERT INTO processes VALUES(1,'abcd1234','adw','',0,'adw_prompt.ts summarize --agent scout --adw-id abcd1234','<TS>','<TS>');
INSERT INTO processes VALUES(2,'abcd1234','agent','scout',0,'pi scout google/gemini-3.6-flash','<TS>','<TS>');
CREATE TABLE agent_sessions (
  adw_id        TEXT REFERENCES sessions,
  agent         TEXT,
  coding_agent  TEXT, model TEXT, color TEXT,
  session_id    TEXT,
  context_tokens INTEGER,           -- window occupancy after the agent's last turn
  context_window INTEGER,           -- the model's ceiling; 0/NULL = unknown
  created_at    TEXT, last_used_at TEXT,
  PRIMARY KEY (adw_id, agent)
);
INSERT INTO agent_sessions VALUES('abcd1234','scout','pi','google/gemini-3.6-flash','','sssf-abcd1234-scout-<HEX4>',15,272000,'<TS>','<TS>');
INSERT INTO sqlite_sequence VALUES('processes',2);
COMMIT;
"
`;

