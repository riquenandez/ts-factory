INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_quality','','log','quality','{"message":"  · passed: True, checks: 4/4, artifacts: adws/adw_data/sessions/abcd1234/context_handoff/quality/02_test/command.log, adws/adw_data/sessions/abcd1234/context_hand…","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_quality','','phase_end','quality','{"status":"success"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','abcd1234_02_quality','','log','quality','{"message":"  ✓ quality <DUR>s","level":"info"}',NULL,'<TS>',NULL);
INSERT INTO events VALUES('evt_<ID>','abcd1234','','','log','console','{"message":"session abcd1234 success · 2/2 phases · 0 tokens · $<COST>","level":"info"}',NULL,'<TS>',NULL);
CREATE TABLE envelopes (
  envelope_id   TEXT PRIMARY KEY,
  adw_id        TEXT REFERENCES sessions,
  phase_id      TEXT REFERENCES phases,
  agent         TEXT,
  output_type   TEXT,
  payload_json  TEXT,
  valid         INTEGER,
  attempt       INTEGER,
  created_at    TEXT
);
CREATE TABLE gate_results (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  adw_id        TEXT REFERENCES sessions,
  phase_id      TEXT REFERENCES phases,
  attempt       INTEGER,
  gate          TEXT,
  passed        INTEGER,
  violations_json TEXT,
  checks_json   TEXT,               -- [{item, ok, note}] — WHAT the gate verified
  created_at    TEXT
);
CREATE TABLE processes (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  adw_id        TEXT REFERENCES sessions,
  kind          TEXT,                -- 'adw' (the workflow process) | 'agent' (a coding-agent child)
  name          TEXT,                -- '' for the adw, the agent name for a child
  pid           INTEGER,
  command       TEXT,                -- what the pid was, so a recycled pid is not killed by mistake
  started_at    TEXT, ended_at TEXT  -- ended_at NULL = believed alive
);
INSERT INTO processes VALUES(1,'abcd1234','adw','',0,'adw_quality.ts check --adw-id abcd1234','<TS>','<TS>');
CREATE TABLE agent_sessions (
  adw_id        TEXT REFERENCES sessions,
  agent         TEXT,
  coding_agent  TEXT, model TEXT, color TEXT,
  session_id    TEXT,
  context_tokens INTEGER,           -- window occupancy after the agent's last turn
  context_window INTEGER,           -- the model's ceiling; 0/NULL = unknown
  created_at    TEXT, last_used_at TEXT,
  PRIMARY KEY (adw_id, agent)
);
INSERT INTO sqlite_sequence VALUES('processes',1);
COMMIT;
"
`;

